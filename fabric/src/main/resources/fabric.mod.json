{
  "schemaVersion": 1,
  "id": "lexikon",
  "version": "${version}",
  "name": "Lexikon",
  "description": "This mod acts as an in-game spell checker, highlighting errors and suggesting corrections as you type in Minecraft chat",
  "authors": [
    "Oiha"
  ],
  "contact" : {
    "homepage" : "https://oiha.fr",
    "sources" : "https://github.com/CaffeineMC/sodium-fabric",
    "issues" : "https://github.com/Oiha-dev/Lexikon/issues"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/lexikon/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.oiha.lexikon.fabric.LexikonFabric"
    ],
    "client": [
      "com.oiha.lexikon.fabric.client.LexikonFabricClient"
    ],
    "modmenu": [ "com.oiha.lexikon.fabric.client.ModMenuIntegration" ]
  },
  "mixins": [
    "lexikon.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https:discord.gg/3D9TwmdPgh",
        "modmenu.kofi": "https://ko-fi.com/oiha_dev"
      }
    }
  }
}
